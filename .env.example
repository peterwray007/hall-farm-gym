# ── The Hall Farm Gym — settings ─────────────────────────────
# Copy this file to one named  .env  and fill in your values.

# Your Stripe SECRET key. Get it from:
#   https://dashboard.stripe.com/test/apikeys   (test mode — starts with sk_test_)
#   https://dashboard.stripe.com/apikeys        (live mode — starts with sk_live_)
# Leave it blank to run in practice mode (no real payments, everything else works).
STRIPE_SECRET_KEY=

# Optional: Stripe webhook signing secret (starts with whsec_).
# Only needed once you deploy publicly and add a webhook in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=

# The passcode for owner mode (blocking out slots for PT sessions).
# CHANGE THIS before going live.
OWNER_PASSCODE=1234

# The public address of the site. For running on your own machine leave as is.
# When you deploy, set it to your real address, e.g. https://book.hallfarmgym.co.uk
BASE_URL=http://localhost:3000

# Port the server runs on.
PORT=3000
